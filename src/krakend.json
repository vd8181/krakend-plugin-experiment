{
  "version": 3,
  "name": "Journal API Gateway",
  "port": 3000,
  "timeout": "10000ms",
  "plugin": {
    "pattern": ".so",  "folder": "/app"},
  "endpoints": [
    {
      "endpoint": "/validatecertificate",
      "method": "POST",
      "output_encoding": "json",


      "backend": [
        {
          "url_pattern": "/clientValidated",
          "host": [
            "http://host.docker.internal:8080"
          ],
          "method": "GET"
        }
      ],
      "extra_config": {

        "qos/ratelimit/router":{
          "max_rate": 2,
          "every": "15s",
          "strategy": "ip",
          "capacity": 4,
          "client_max_rate": 1,

          "client_capacity": 5
        }
      }

    },
    {
      "endpoint": "/journals/{customer_id}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/journals",
          "host": [
            "http://host.docker.internal:8080"
          ],
          "encoding": "json",
          "is_collection": "true"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router":{

          "every": "15s",
          "strategy": "param",
          "key": "customer_id",

          "client_max_rate": 1,
          "client_capacity": 3
        }
      }

    },
    {
      "endpoint": "/journals",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/journals",
          "host": [
            "http://host.docker.internal:8080"
          ]
        }
      ]
    }

  ],
  "extra_config": {
    "plugin/http-server": {
      "name": ["validator"],
      "validator": {
        "path": "/validatecertificate"
      }
    },
    "plugin/http-server": {
      "name": ["rate_limiting"],
      "rate_limiting": {
        "path": "/rate_limiting"
      }
    },
    "qos/ratelimit/tiered": {
      "tier_key": "Tier",
      "tiers": [
        {
          "tier_value": "gold",
          "tier_value_as": "literal",
          "client_max_rate": 5,
          "client_capacity": 5,
          "every": "1m",
          "max_rate": 10,
          "strategy": "header",
          "key": "Tenant-Id"
        },     {
          "tier_value": "silver",
          "tier_value_as": "literal",
          "client_max_rate": 3,
          "client_capacity": 3,
          "every": "1m",
          "max_rate": 5,
          "strategy": "header",
          "key": "Tenant-Id"
        }
      ]
    }
  }
}