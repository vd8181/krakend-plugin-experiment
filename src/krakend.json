{
  "version": 3,
  "name": "Journal API Gateway",
  "port": 3000,
  "timeout": "10000ms",  "plugin": {  "pattern": ".so",  "folder": "/app"},
  "endpoints": [
    {
      "endpoint": "/validatecertificate",
      "method": "POST",
      "output_encoding": "json",


      "backend": [
      {
        "url_pattern": "/clientValidated",
        "host": [
          "http://host.docker.internal:8080"
        ],
        "method": "GET"
      }
    ],
      "extra_config": {
        "plugin/http-server": {
        "name": ["validator"],
        "validator": {
          "path": "/validatecertificate"
        }
      },
      "qos/ratelimit/router":{
        "max_rate": 3,
        "every": "1s",
        "strategy": "ip",
        "capacity": 3,
        "client_max_rate": 1,

        "client_capacity": 3
      }
    }

    },
    {
      "endpoint": "/journals",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/journals",
          "host": [
            "http://host.docker.internal:8080"
          ],
          "encoding": "json",
          "is_collection": "true"
        }
      ],
      "extra_config": {
      "qos/ratelimit/router":{
        "max_rate": 3,
        "every": "1s",
        "strategy": "ip",
        "capacity": 3,
        "client_max_rate": 1,
        "client_capacity": 3
      }
    }

    },
    {
      "endpoint": "/journals",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/journals",
          "host": [
            "http://host.docker.internal:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/journals/{title}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/journals/{title}",
          "host": [
            "http://host.docker.internal:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/journals/{title}",
      "method": "DELETE",
      "backend": [
        {
          "url_pattern": "/journals/{title}",
          "host": [
            "http://host.docker.internal:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/journals",
      "method": "PUT",
      "backend": [
        {
          "url_pattern": "/journals",
          "host": [
            "http://host.docker.internal:8080"
          ]
        }
      ]
    }
  ],
  "extra_config": {
    "plugin/http-server": {
      "name": ["validator"],
      "validator": {
        "path": "/validatecertificate"
      }
    },
    "qos/ratelimit/service": {
      "max_rate": 3,
      "client_max_rate": 3,
      "strategy": "ip",     "every": "1s",
      "capacity": 3,
      "client_capacity": 3
    }
  }
}